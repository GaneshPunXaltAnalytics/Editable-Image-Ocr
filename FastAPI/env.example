# LaMa Model Configuration
# Path to the LaMa model directory (relative to PROJECT_ROOT or absolute path)
LAMA_MODEL_PATH=pretrained_models/big-lama

# Output Configuration
# Directory where processed images are saved (relative to PROJECT_ROOT or absolute path)
OUTPUTS_ROOT=saved_outputs

# CORS Configuration
# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Logging Configuration
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Device Configuration
# Device for LaMa inference: cpu, cuda, cuda:0, etc.
DEVICE=cpu

# OpenCV Inpainting Configuration
# Radius for OpenCV inpainting fallback method (default: 3)
OPENCV_INPAINT_RADIUS=3

# OCR Configuration
# Enable OCR text extraction from polygons (default: false)
# Set to "true" to enable OCR functionality
USE_OCR=false

# OCRFlux Configuration (only used when USE_OCR=true)
# Path to OCRFlux model directory (relative to PROJECT_ROOT or absolute path)
OCRFLUX_MODEL_PATH=./models/OCRFlux-3B
# GPU memory utilization (0.0-1.0, default: 0.8)
OCRFLUX_GPU_UTIL=0.8
# Maximum model length (default: 8192)
OCRFLUX_MAX_MODEL_LEN=8192
# Processing mode: "per_polygon" (process each cropped region, more accurate) 
# or "full_image" (process full image once, faster but less accurate for polygon matching)
OCRFLUX_MODE=per_polygon

# Inpainting Configuration
# Approach selection: "true" (expanded crop) or "false" (full image)
# Option 1 (expanded crop, default): Processes cropped region with mask ratio ≤ INPAINT_MAX_MASK_RATIO
# Option 2 (full image): Processes entire image with full mask (original behavior)
INPAINT_USE_EXPANDED_CROP=true

# Expanded Crop Configuration (only used when INPAINT_USE_EXPANDED_CROP=true)
# Maximum mask ratio in expanded crop region (default: 0.15 = 15%)
# The selected polygon region will be expanded so masked pixels ≤ this ratio
INPAINT_MAX_MASK_RATIO=0.15
# Minimum expansion in pixels around selected region (default: 50)
INPAINT_MIN_EXPANSION=50
# Maximum expansion in pixels around selected region (default: 500)
INPAINT_MAX_EXPANSION=500

# Mask Padding Configuration
# Padding/dilation size in pixels to expand mask boundaries (default: 0 = no padding)
# Useful for ensuring mask edges are fully covered or for slight expansion
# Example: MASK_PADDING=5 will expand mask by 5 pixels in all directions
MASK_PADDING=0

# OCR Parallel Processing Configuration (only used when USE_OCR=true)
# Maximum number of parallel workers for OCR extraction (default: auto-detected)
# Set to 1 to disable parallel processing
OCR_MAX_WORKERS=

# API Configuration
# FastAPI application title
API_TITLE=Image Inpainting API

# Project Root (optional)
# Override auto-detected project root path
# PROJECT_ROOT=/custom/path/to/project

