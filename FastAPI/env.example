# LaMa Model Configuration
# Path to the LaMa model directory (relative to PROJECT_ROOT or absolute path)
LAMA_MODEL_PATH=pretrained_models/big-lama

# Output Configuration
# Directory where processed images are saved (relative to PROJECT_ROOT or absolute path)
OUTPUTS_ROOT=saved_outputs

# CORS Configuration
# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Logging Configuration
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Device Configuration
# Device for LaMa inference: cpu, cuda, cuda:0, etc.
DEVICE=cpu

# OpenCV Inpainting Configuration
# Radius for OpenCV inpainting fallback method (default: 3)
OPENCV_INPAINT_RADIUS=3

# OCR Parallel Processing Configuration
# Maximum number of parallel workers for OCR extraction (default: auto-detected)
# Set to 1 to disable parallel processing
OCR_MAX_WORKERS=

# API Configuration
# FastAPI application title
API_TITLE=Image Inpainting API

# Project Root (optional)
# Override auto-detected project root path
# PROJECT_ROOT=/custom/path/to/project

